				{ text = "[Kamo] Lee la sangre para hallar dónde termina el niño", desc = "Encontraste el límite solo por el pulso y trabajaste dentro de él. Limpio, preciso, y exactamente el tipo de cosa que la gente teme que tu familia sepa hacer." },
				{ text = "[Clan] Pide apoyo del clan y aguanta hasta que llegue", desc = "Mandaste razón por la línea familiar y sostuviste al niño quieto hasta que gente con más autoridad que tú tomó el control. El resultado fue bueno. El crédito no fue tuyo." },
